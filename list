-- Menggunakan PlaceId agar lebih spesifik mendeteksi tempat/game saat ini
local currentID = game.PlaceId

-- Daftar script yang dikelompokkan berdasarkan Place ID game
local scripts = {
    [107192230357786] = "https://raw.githubusercontent.com/mawutz/load/refs/heads/main/fish%20for%20secret%20animals",
}

-- Cek apakah ID game saat ini ada di dalam daftar
local targetScript = scripts[currentID]

if targetScript then
    print("Place ID terdeteksi: " .. tostring(currentID) .. ". Memuat script...")
    local success, err = pcall(function()
        loadstring(game:HttpGet(targetScript))()
    end)
    
    if not success then
        warn("Gagal menjalankan script: " .. tostring(err))
    end
else
    -- Syntax warn yang tadinya error sudah diperbaiki di sini:
    warn("Script untuk Place ID " .. tostring(currentID) .. " tidak ditemukan di dalam daftar.")
end
