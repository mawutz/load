-- Fungsi Notifikasi Dwibahasa
local function showNotification(title, text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = 5
        })
    end)

    local NotifBanner = Instance.new("Frame")
    NotifBanner.Size = UDim2.new(0.9, 0, 0, 55)
    NotifBanner.Position = UDim2.new(0.5, 0, 0.5, 0)
    NotifBanner.AnchorPoint = Vector2.new(0.5, 0.5)
    NotifBanner.BackgroundColor3 = Color3.fromRGB(25, 10, 20)
    NotifBanner.ZIndex = 10
    NotifBanner.Parent = MainFrame

    local BannerCorner = Instance.new("UICorner")
    BannerCorner.CornerRadius = UDim.new(0, 8)
    BannerCorner.Parent = NotifBanner

    local BannerStroke = Instance.new("UIStroke")
    BannerStroke.Color = Color3.fromRGB(239, 68, 68)
    BannerStroke.Thickness = 2
    BannerStroke.Parent = NotifBanner

    local BannerText = Instance.new("TextLabel")
    BannerText.Size = UDim2.new(1, -10, 1, -6)
    BannerText.Position = UDim2.new(0, 5, 0, 3)
    BannerText.BackgroundTransparency = 1
    BannerText.Text = text
    BannerText.TextColor3 = Color3.fromRGB(255, 255, 255)
    BannerText.Font = Enum.Font.GothamBold
    BannerText.TextSize = 10
    BannerText.TextWrapped = true
    BannerText.ZIndex = 11
    BannerText.Parent = NotifBanner

    task.delay(3.5, function()
        if NotifBanner then
            NotifBanner:Destroy()
        end
    end)
end

-- Aksi Tombol OPEN SCRIPT
OpenButton.MouseButton1Click:Connect(function()
    local targetGame = supportedGames[currentID]

    if targetGame then
        OpenButton.Text = "LOADING..."
        local success, err = pcall(function()
            loadstring(game:HttpGet(targetGame.ScriptUrl))()
        end)

        if success then
            ScreenGui:Destroy()
        else
            OpenButton.Text = "OPEN SCRIPT"
            showNotification("Error", "Failed to load script / Gagal memuat:\n" .. tostring(err))
        end
    else
        showNotification(
            "Unsupported Game / Game Tidak Tersedia",
            "❌ This game is not available yet.\n❌ Game ini belum tersedia di dalam daftar."
        )
    end
end)
