-- Fungsi mengambil daftar Rod dari Config game
local function getConfigRodList()
    local list = {}
    local success, Config = pcall(function()
        return require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
    end)
    if success and Config and Config.Rods then
        for _, rodData in ipairs(Config.Rods) do
            if rodData.Id then
                table.insert(list, rodData.Id)
            end
        end
    end
    if #list == 0 then
        list = { "Wooden", "Stone", "Iron", "Steel", "Gold", "Diamond", "Crystal", "Ruby", "Emerald", "Abyssal", "UFO" }
    end
    return list
end

-- Fungsi mengambil daftar Trail dari Config game secara dinamis
getConfigTrailList = function()
    local list = {}
    local success, Config = pcall(function()
