end

local function findMyPlot()
    local map = workspace:FindFirstChild("Map")
    local plotProps = map and map:FindFirstChild("PlotProps")
    if not plotProps then return nil end

    for _, plot in ipairs(plotProps:GetChildren()) do
        local barSignAnchor = plot:FindFirstChild("BarSignAnchor")
        local barUpgradePrompt = barSignAnchor and barSignAnchor:FindFirstChild("BarUpgradePrompt")
        
        if barSignAnchor then
            for _, attrName in ipairs({ "Owner", "Player", "UserId", "OwnerId", "OwnerUserId", "Plr" }) do
                local val = plot:GetAttribute(attrName) or barSignAnchor:GetAttribute(attrName)
                if barUpgradePrompt then
                    val = val or barUpgradePrompt:GetAttribute(attrName)
                end

                if typeof(val) == "Instance" and val == LocalPlayer then
                    return plot
                elseif type(val) == "number" and val == LocalPlayer.UserId then
                    return plot
                elseif type(val) == "string" and (val == LocalPlayer.Name or tostring(LocalPlayer.UserId) == val) then
                    return plot
                end
            end
            
            if string.find(string.lower(plot.Name), string.lower(LocalPlayer.Name)) then
                return plot
            end
        end
    end

    for _, plot in ipairs(plotProps:GetChildren()) do
        local barSignAnchor = plot:FindFirstChild("BarSignAnchor")
        if barSignAnchor then
            local character = LocalPlayer.Character
            local rootPart = character and character:FindFirstChild("HumanoidRootPart")
            if rootPart then
                local targetPos = plot:GetPivot().Position
                if (targetPos - rootPart.Position).Magnitude <= 45 then
                    return plot
                end
            end
        end
    end

    return nil
end

local function getPlotTrainingPosition()
    if cachedTrainingCFrame then
        return cachedTrainingCFrame
    end

    local myPlot = findMyPlot()
    if myPlot then
        local barSignAnchor = myPlot:FindFirstChild("BarSignAnchor")
        if barSignAnchor and barSignAnchor:IsA("BasePart") then
            cachedTrainingCFrame = barSignAnchor.CFrame + Vector3.new(0, 3, 0)
            return cachedTrainingCFrame
        elseif myPlot.PrimaryPart then
            cachedTrainingCFrame = myPlot:GetPivot() + Vector3.new(0, 3, 0)
            return cachedTrainingCFrame
        end
    end
    return nil
end

local function invokeOrFireStopTraining()
    pcall(function()
        if StopTrainingRemote:IsA("RemoteFunction") then
            StopTrainingRemote:InvokeServer()
        else
            StopTrainingRemote:FireServer()
        end
    end)
    isTrainingActive = false
end

local function invokeOrFireStartTraining()
    local success = pcall(function()
        if StartTrainingRemote:IsA("RemoteFunction") then
            StartTrainingRemote:InvokeServer()
        else
            StartTrainingRemote:FireServer()
        end
    end)
    if success then
        isTrainingActive = true
    end
    return success
end

local function setCastHolderHidden(hidden)
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return end

    local castGui = playerGui:FindFirstChild("CastGui")
    if castGui then
        for _, childName in ipairs({ "Aim", "Slots", "Secret", "LuckButton" }) do
            local frame = castGui:FindFirstChild(childName)
            if frame and frame:IsA("GuiObject") then
                if hidden then
                    if savedGuiStates[frame] == nil then
                        savedGuiStates[frame] = frame.Visible
                    end
                    frame.Visible = false
                else
                    if savedGuiStates[frame] ~= nil then
                        frame.Visible = savedGuiStates[frame]
                        savedGuiStates[frame] = nil
                    else
                        frame.Visible = false
                    end
                end
            end
        end
    end

    for _, guiName in ipairs({ "CastScreenUnder", "CastScreenOver" }) do
        local screenGui = playerGui:FindFirstChild(guiName)
        if screenGui and screenGui:IsA("ScreenGui") then
            screenGui.Enabled = not hidden
        end
    end
end

local function setBackgroundMode(active)
    local camera = workspace.CurrentCamera
    setCastHolderHidden(active)

    if active then
        if camera then
            if savedCameraType == nil then savedCameraType = camera.CameraType end
            if savedFieldOfView == nil then savedFieldOfView = camera.FieldOfView end
            camera.CameraType = Enum.CameraType.Custom
        end
    else
        pcall(function() GuiService.SelectedObject = nil end)

        if camera then
            camera.CameraType = savedCameraType or Enum.CameraType.Custom
            if savedFieldOfView ~= nil then camera.FieldOfView = savedFieldOfView end
            savedCameraType = nil
            savedFieldOfView = nil
        end

        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.WalkSpeed = humanoid.WalkSpeed > 0 and humanoid.WalkSpeed or 16
            humanoid.JumpPower = humanoid.JumpPower > 0 and humanoid.JumpPower or 50
        end

        pcall(function() CastBeginRemote:FireServer() end)
        pcall(function()
            local castEnd = Remotes:FindFirstChild("CastEnd")
            if castEnd and castEnd:IsA("RemoteEvent") then
                castEnd:FireServer()
            elseif castEnd and castEnd:IsA("RemoteFunction") then
                castEnd:InvokeServer()
            end
        end)
    end
end

local function teleportToStart()
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end

    rootPart.AssemblyLinearVelocity = Vector3.zero
    rootPart.CFrame = CFrame.new(startPosition)
    return true
end

local function extractCatchId(response)
    if type(response) == "table" then
        return response.Id or response.id or response.CatchId or response.catchId
    elseif type(response) == "string" or type(response) == "number" then
        return response
    end
    return nil
end

local function runCycle()
    if isCasting or not autoFarmEnabled then return end
    isCasting = true
    setBackgroundMode(true)

    teleportToStart()
    task.wait(0.2)
    if not autoFarmEnabled then
        isCasting = false
        setBackgroundMode(false)
        return
    end

    local okBegin = pcall(function() CastBeginRemote:InvokeServer() end)
    if not okBegin or not autoFarmEnabled then
        isCasting = false
        setBackgroundMode(false)
        return
    end

    task.wait(waitBeforeCast)
    if not autoFarmEnabled then
        isCasting = false
        setBackgroundMode(false)
        return
    end

    local okCast, castResponse = pcall(function() return CastRemote:InvokeServer(1, 1) end)
    if not okCast then
        isCasting = false
        setBackgroundMode(false)
        return
    end

    task.wait(waitForCatch)
    local claimedId = extractCatchId(castResponse)
    if autoFarmEnabled and claimedId ~= nil then
        pcall(function() ClaimCatchRemote:InvokeServer(tostring(claimedId)) end)
    end

    task.wait(waitAfterClaim)

    if autoFarmEnabled then
        pcall(function() StoreBeastRemote:FireServer(storeBeastId) end)
    end

    task.wait(loopCooldown)
    isCasting = false
end

